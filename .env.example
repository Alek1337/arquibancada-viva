# Runtime comum
NODE_ENV=development
LOG_LEVEL=info

# Web (valores públicos incorporáveis ao cliente)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# API
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
AUTH_SECRET=change-me-development-only-32-characters

# PostgreSQL e Redis locais
DATABASE_URL=postgresql://app:app@localhost:5432/arquibancada_viva
API_DATABASE_POOL_MAX=10
WORKER_DATABASE_POOL_MAX=5
REDIS_URL=redis://localhost:6379
POSTGRES_PORT=5432
REDIS_PORT=6379

# Armazenamento S3-compatible local
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_REGION=us-east-1
S3_BUCKET=arquibancada-viva-local
S3_ACCESS_KEY_ID=local-development
S3_SECRET_ACCESS_KEY=change-me-development-only-32-characters

# Worker
WORKER_CONCURRENCY=5
WORKER_PROBE_HOST=127.0.0.1
WORKER_PROBE_PORT=3002
