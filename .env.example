# Runtime comum
NODE_ENV=development
LOG_LEVEL=info
OBSERVABILITY_EXPORT_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SENTRY_DSN=https://public-key@example.invalid/1

# Web (valores públicos incorporáveis ao cliente)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# API
API_HOST=127.0.0.1
API_PORT=3001
API_BODY_LIMIT_BYTES=65536
WEB_ORIGIN=http://localhost:3000
AUTH_BASE_URL=http://localhost:3001
AUTH_SECRET=change-me-development-only-32-characters

# PostgreSQL e Redis locais
DATABASE_URL=postgresql://app:app@localhost:5432/arquibancada_viva
API_DATABASE_POOL_MAX=10
WORKER_DATABASE_POOL_MAX=5
REDIS_URL=redis://localhost:6379
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=120
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_MUTATION_MAX=30
POSTGRES_PORT=5432
REDIS_PORT=6379

# Armazenamento S3-compatible local
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_REGION=us-east-1
S3_BUCKET=arquibancada-viva-local
S3_ACCESS_KEY_ID=local-development
S3_SECRET_ACCESS_KEY=change-me-development-only-32-characters
S3_FORCE_PATH_STYLE=true

# Worker
WORKER_CONCURRENCY=5
WORKER_PROBE_HOST=127.0.0.1
WORKER_PROBE_PORT=3002
