{
  "name": "arquibancada-viva",
  "version": "0.0.0",
  "private": true,
  "description": "Identificador técnico provisório para o jogo social de torcidas.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.14.1 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "pnpm -r --if-present test:e2e"
  }
}
