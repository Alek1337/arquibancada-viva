{
  "name": "arquibancada-viva",
  "version": "0.0.0",
  "private": true,
  "description": "Jogo social de arquibancada em tempo real para navegador.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.14.1 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && pnpm lint:boundaries",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:boundaries && pnpm -r --if-present test",
    "test:boundaries": "node --test scripts/check-boundaries.test.mjs",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "pnpm -r --if-present test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
