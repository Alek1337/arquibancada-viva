{
  "name": "arquibancada-viva",
  "version": "0.0.0",
  "private": true,
  "description": "Jogo social de arquibancada em tempo real para navegador.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.14.1 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "auth:schema": "pnpm --filter @arquibancada-viva/auth auth:schema",
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:api": "pnpm --filter @arquibancada-viva/api dev",
    "dev:web": "pnpm --filter @arquibancada-viva/web dev",
    "dev:worker": "pnpm --filter @arquibancada-viva/worker dev",
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:check": "pnpm --filter @arquibancada-viva/database db:check",
    "db:generate": "pnpm --filter @arquibancada-viva/database db:generate",
    "db:migrate": "pnpm --filter @arquibancada-viva/database db:migrate",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "infra:config": "docker compose config --quiet",
    "infra:down": "docker compose down --remove-orphans",
    "infra:logs": "docker compose logs --tail=200",
    "infra:status": "docker compose ps",
    "infra:up": "docker compose up --detach --wait postgres redis storage && docker compose run --rm storage-init",
    "lint": "biome lint . && pnpm lint:boundaries",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:boundaries && pnpm -r --if-present test",
    "test:boundaries": "node --test scripts/check-boundaries.test.mjs",
    "test:integration": "pnpm -r --if-present test:integration",
    "start:api": "pnpm --filter @arquibancada-viva/api start",
    "start:web": "pnpm --filter @arquibancada-viva/web start",
    "start:worker": "pnpm --filter @arquibancada-viva/worker start",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "test:smoke": "node scripts/smoke-apps.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
