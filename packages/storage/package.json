{
  "name": "@arquibancada-viva/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run src/storage.integration.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arquibancada-viva/config": "workspace:*",
    "@aws-sdk/client-s3": "3.1138.0",
    "@aws-sdk/s3-request-presigner": "3.1138.0",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@types/node": "24.13.4"
  }
}
