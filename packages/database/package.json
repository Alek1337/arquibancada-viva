{
  "name": "@arquibancada-viva/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "db:check": "drizzle-kit check --config drizzle.config.ts && node scripts/check-migrations.mjs",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts && node scripts/check-migrations.mjs",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run src/database.integration.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arquibancada-viva/config": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10"
  }
}
