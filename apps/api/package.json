{
  "name": "@arquibancada-viva/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "default": "./src/main.ts"
    }
  },
  "scripts": {
    "auth:schema": "auth generate --config src/spikes/better-auth/auth.cli.ts --output ../../packages/database/src/schema/auth/better-auth.ts --yes",
    "build": "tsup --config tsup.config.ts",
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/main.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run src/spikes/better-auth/better-auth.integration.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arquibancada-viva/config": "workspace:*",
    "@arquibancada-viva/database": "workspace:*",
    "@better-auth/drizzle-adapter": "1.7.4",
    "@fastify/cors": "11.3.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-fastify": "11.2.3",
    "better-auth": "1.7.4",
    "fastify": "5.11.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "auth": "1.7.4",
    "socket.io-client": "4.8.3",
    "tsup": "8.5.1",
    "tsx": "4.23.13"
  }
}
