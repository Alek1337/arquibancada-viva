{
  "name": "@arquibancada-viva/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "default": "./src/main.ts"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/main.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "vitest run --exclude src/**/*.integration.test.ts",
    "test:integration": "vitest run src/queue/queue.integration.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arquibancada-viva/config": "workspace:*",
    "@arquibancada-viva/contracts": "workspace:*",
    "@arquibancada-viva/database": "workspace:*",
    "@arquibancada-viva/observability": "workspace:*",
    "@arquibancada-viva/storage": "workspace:*",
    "bullmq": "6.3.4",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "tsup": "8.5.1",
    "tsx": "4.23.13"
  }
}
